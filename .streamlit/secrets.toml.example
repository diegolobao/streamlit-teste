# secrets.toml.example — Template para configurar no Streamlit Cloud
# Copie este arquivo como secrets.toml e preencha os valores,
# OU configure diretamente em: App Settings → Secrets no painel do Streamlit Cloud.
# NUNCA commite o secrets.toml real (já está no .gitignore).

# ── Supabase ──
SUPABASE_URL = "https://<seu-projeto>.supabase.co"
SUPABASE_KEY = "<service_role_key>"

# ── SSL (manter false em redes com proxy corporativo Petrobras) ──
SSL_VERIFY = "false"

# ── Databricks SQL Warehouse ──
DATABRICKS_HOST      = "<workspace>.azuredatabricks.net"
DATABRICKS_HTTP_PATH = "/sql/1.0/warehouses/<id>"
DATABRICKS_TOKEN     = "dapi<token>"
DATABRICKS_CATALOG   = "dt0046_prd"
DATABRICKS_SCHEMA    = "sap_pm_consumo"
DATABRICKS_TABLE     = "notas_texto_longo_zf_zi_zs"
DATABRICKS_TABLE_ZP  = "notas_texto_longo_zc_ze_zo_zp_zr"

# ── Azure OpenAI (API corporativa Petrobras) ──
AZURE_OPENAI_BASE_URL    = "https://apit.petrobras.com.br/ia/openai/v1/openai-azure/openai"
AZURE_OPENAI_API_KEY     = "<chave>"
AZURE_OPENAI_API_VERSION = "2024-08-01-preview"
AZURE_OPENAI_MODEL       = "gpt-4o-petrobras"
